# Copy to .env.local for local development. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Local only: sign in without Google, and use a fake Google Calendar stored in the local database.
# These are ignored on Vercel.
DEV_LOGIN=1
FAKE_GOOGLE=1

# Database. Leave unset locally: `npm run dev` runs Postgres in-process (PGlite). On Vercel, the Supabase integration
# sets POSTGRES_URL. DATABASE_URL, if set, wins over both.
# DATABASE_URL=

# Google (fill in to test real sign-in and calendars locally, and remove DEV_LOGIN and FAKE_GOOGLE):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Optional
# APP_NAME=Semsync
# SYNC_CONCURRENCY=8          # people a sync run works on at once
# APP_URL=https://semsync.live   # for links in calendars and AI assistant sign in; on Vercel it defaults to the production domain
# MOVE_OLD_ADDRESS=1   # on Vercel, send visitors from the .vercel.app address to APP_URL (see docs/deploying.md)
# ALLOWED_CANVAS_HOSTS=canvas.nus.edu.sg
