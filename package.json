{
  "name": "semsync",
  "version": "0.1.0",
  "private": true,
  "description": "Canvas deadlines, NUSMods classes and exams, synced into one shared Google Calendar.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply semsync --local",
    "db:migrate:remote": "wrangler d1 migrations apply semsync --remote"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
