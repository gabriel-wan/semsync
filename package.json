{
  "name": "semsync",
  "version": "0.2.0",
  "private": true,
  "description": "Canvas deadlines, NUSMods classes and exams, synced into Google Calendar.",
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/dev.ts",
    "start": "tsx --env-file-if-exists=.env.local src/dev.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/migrate.ts --production-build-only",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "sql": "tsx --env-file-if-exists=.env.local scripts/sql.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
