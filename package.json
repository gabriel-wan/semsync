{
  "name": "semsync",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://semsync.live",
  "description": "Your NUS semester in your calendar: Canvas deadlines, NUSMods classes and exams, kept up to date in Google Calendar, Outlook or Apple Calendar.",
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/dev.ts",
    "start": "tsx --env-file-if-exists=.env.local src/dev.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/migrate.ts --production-build-only",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "sql": "tsx --env-file-if-exists=.env.local scripts/sql.ts"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@hono/node-server": "^2.1.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
